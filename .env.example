# ==============================================================================
# CodeExpo - Complete Environment Variables Reference
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND ENVIRONMENT VARIABLES (Configure on RENDER / Railway / Heroku)
# ------------------------------------------------------------------------------
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/Code-Expo?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend Application URL (Set to your Vercel production URL)
FRONTEND_URL=https://your-codeexpo-app.vercel.app

# Backend Host URL (Set to your Render production URL)
HOST_URL=https://your-backend-service.onrender.com

# Cloudinary Media Storage (For post attachments, avatar uploads & assets)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google OAuth Login
GOOGLE_LOGIN_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Gemini AI Assistant & Analysis
GEMINI_API_KEY=your_gemini_api_key_here

# Code Compiler Execution (Judge0 via RapidAPI)
RAPID_API_KEY=your_rapidapi_judge0_key_here
RAPID_API_HOST=judge0-ce.p.rapidapi.com
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com/submissions

# Email Verification & Password Reset (Choose SMTP or Resend API)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="CodeExpo" <noreply@codeexpo.com>
# Or use Resend:
# RESEND_API_KEY=re_your_resend_api_key_here

# ------------------------------------------------------------------------------
# 2. FRONTEND ENVIRONMENT VARIABLES (Configure on VERCEL / Netlify)
# ------------------------------------------------------------------------------
# Deployed Backend URL (No trailing slash)
VITE_BACKEND_URL=https://your-backend-service.onrender.com

# Google OAuth Client ID (Matching backend GOOGLE_LOGIN_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
