# ==============================================================================
# CodeExpo - Frontend Environment Variables (Vercel / Client)
# ==============================================================================

# Backend Server URL (Render URL, without trailing slash)
VITE_BACKEND_URL=https://your-backend-service.onrender.com

# Google OAuth Client ID (Must match backend GOOGLE_LOGIN_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
